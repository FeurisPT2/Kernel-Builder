# ==============================================================================
# Android Kernel Builder Configuration File
# Copy this file to config.env and edit it for your device.
# ==============================================================================

# Device details
DEVICE_NAME="example_device"              # Codename of your phone (e.g., alioth, sweet, vayu, gki)
DEVICE_MODEL="Android Phone"             # Human-readable name (e.g., POCO F3, Redmi Note 10 Pro)

# Kernel Source Repository
KERNEL_SOURCE="https://github.com/example/android_kernel_device.git"
KERNEL_BRANCH="lineage-20"
KERNEL_DEFCONFIG="vendor/example-perf_defconfig" # Defconfig path inside arch/arm64/configs/

# Kernel Architecture
ARCH="arm64"
SUBARCH="arm64"

# Toolchain Configuration
# Supported TOOLCHAIN_TYPE:
#   - proton-clang  (Recommended for non-GKI 4.14, 4.19, 5.4 kernels, LLVM 13/14 with integrated sysroot)
#   - aosp-clang    (Recommended for GKI 5.10, 5.15, 6.1+ kernels)
#   - azure-clang   (Alternative bleeding-edge LLVM)
TOOLCHAIN_TYPE="proton-clang"

# For aosp-clang: specify Clang build ID (e.g., r450784d, r487747c, r510928, r416183b)
# Ignored when TOOLCHAIN_TYPE="proton-clang"
AOSP_CLANG_VERSION="r450784d"

# Build LLVM flags:
# Set LLVM=1 if the kernel supports full LLVM toolchain (lld, llvm-ar, llvm-nm, etc.)
# If the kernel has linker issues with ld.lld, set LLVM=0
LLVM="1"

# ReSukiSU Integration
ENABLE_RESUKISU=true
RESUKISU_REPO="https://github.com/ReSukiSU/ReSukiSU.git"
RESUKISU_BRANCH="main"

# SUSFS (susfs4ksu) Integration
ENABLE_SUSFS=true
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu.git"
# Set to "auto" to automatically match kernel version (e.g., kernel-4.19, gki-android12-5.10, etc.)
# Or specify an explicit branch name
SUSFS_BRANCH="auto"

# Packaging Configuration
ENABLE_ANYKERNEL3=true
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3.git"
ANYKERNEL3_BRANCH="master"

# Target output binary name:
# Common choices: Image, Image.gz, Image.gz-dtb
KERNEL_IMAGE_NAME="Image.gz-dtb"

# Extra build flags or targets (e.g., dtbo.img, dtb.img)
BUILD_DTBO=false
EXTRA_MAKE_FLAGS=""
