# ==============================================================================
# KernelSU & ReSukiSU Kconfig Configurations
# ==============================================================================

# Enable KernelSU core
CONFIG_KSU=y

# Disable debug logging by default to save overhead and stay stealthy
CONFIG_KSU_DEBUG=n

# Multi-manager support allows KernelSU, ReSukiSU and SukiSU managers
CONFIG_KSU_MULTI_MANAGER_SUPPORT=y

# Essential kernel features required by KernelSU & hooks
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_OVERLAY_FS=y
