# Xiaomi 13T Pro / Redmi K60 Ultra (corot - MediaTek Dimensity 9200+ - Kernel 5.15)
DEVICE_NAME="corot"
DEVICE_MODEL="Xiaomi 13T Pro / Redmi K60 Ultra"

KERNEL_SOURCE="https://github.com/MiCode/Xiaomi_Kernel_OpenSource.git"
KERNEL_BRANCH="corot-t-oss"
KERNEL_DEFCONFIG="gki_defconfig"

ARCH="arm64"
SUBARCH="arm64"

# Android 13 5.15 kernel uses AOSP Clang r450784e
TOOLCHAIN_TYPE="aosp-clang"
AOSP_CLANG_VERSION="r450784e"
LLVM="1"

ENABLE_RESUKISU=true
RESUKISU_REPO="https://github.com/ReSukiSU/ReSukiSU.git"
RESUKISU_BRANCH="main"

ENABLE_SUSFS=true
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu.git"
SUSFS_BRANCH="gki-android13-5.15"

ENABLE_ANYKERNEL3=true
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3.git"
ANYKERNEL3_BRANCH="master"

KERNEL_IMAGE_NAME="Image"
BUILD_DTBO=false
EXTRA_MAKE_FLAGS=""
