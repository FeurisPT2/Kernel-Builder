# Xiaomi Snapdragon 865 (SM8250 - Kernel 4.19) Example Configuration
DEVICE_NAME="alioth"
DEVICE_MODEL="POCO F3 / Redmi K40"

KERNEL_SOURCE="https://github.com/LineageOS/android_kernel_xiaomi_sm8250.git"
KERNEL_BRANCH="lineage-20"
KERNEL_DEFCONFIG="vendor/kona-perf_defconfig"

ARCH="arm64"
SUBARCH="arm64"

# Older 4.19 kernels work great with Proton Clang
TOOLCHAIN_TYPE="proton-clang"
LLVM="1"

ENABLE_RESUKISU=true
RESUKISU_REPO="https://github.com/ReSukiSU/ReSukiSU.git"
RESUKISU_BRANCH="main"

ENABLE_SUSFS=true
SUSFS_REPO="https://gitlab.com/simonpunk/susfs4ksu.git"
SUSFS_BRANCH="kernel-4.19"

ENABLE_ANYKERNEL3=true
ANYKERNEL3_REPO="https://github.com/osm0sis/AnyKernel3.git"
ANYKERNEL3_BRANCH="master"

KERNEL_IMAGE_NAME="Image"
BUILD_DTBO=true
EXTRA_MAKE_FLAGS=""
