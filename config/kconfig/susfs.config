# ==============================================================================
# SUSFS (susfs4ksu) Kconfig Configurations for ReSukiSU
# ==============================================================================

# Enable SUSFS Inline Hook
CONFIG_KSU_SUSFS=y

# Hide suspicious paths and mounts
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y

# Spoof suspicious kstat (file timestamps, inodes, sizes)
CONFIG_KSU_SUSFS_SUS_KSTAT=y

# Spoof uname syscall output
CONFIG_KSU_SUSFS_SPOOF_UNAME=y

# SUSFS kernel logging (Disable if pure stealth is required)
CONFIG_KSU_SUSFS_ENABLE_LOG=y

# Automatically hide KSU & SUSFS symbols from /proc/kallsyms
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y

# Spoof /proc/cmdline (non-GKI) or /proc/bootconfig (GKI)
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y

# Open redirect support
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y

# Hide mmapped files from /proc/<pid>/maps
CONFIG_KSU_SUSFS_SUS_MAP=y
